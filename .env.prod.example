# Variables de `docker-compose.prod.yml` (Dokploy). Copia-les al panell del projecte.
# Cap valor d'aquí és un secret real: els de debò es generen al servidor.

# ── Dominis ───────────────────────────────────────────────────────────────────
# Els dos han d'apuntar a la IP del VPS abans del primer desplegament.
DOMAIN=quiz.cat
STORAGE_DOMAIN=storage.quiz.cat

# ── Base de dades ─────────────────────────────────────────────────────────────
POSTGRES_DB=quizcat
POSTGRES_USER=quizcat
POSTGRES_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Obligatori: sense això l'API no arrenca. Genera'l amb `openssl rand -base64 48`.
JWT_SECRET=

# ── Mèdia (MinIO) ─────────────────────────────────────────────────────────────
# Les mateixes claus fan de credencials del MinIO i de l'S3 que llegeix l'API.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=quizcat-media

# ── Seed ──────────────────────────────────────────────────────────────────────
# SEED_ON_BOOT=1 només al primer desplegament (o després d'afegir contingut): són
# ~3.300 preguntes i tarda uns minuts. Torna'l a 0 després: tornar-lo a executar no
# trenca res, però cada passada afegeix ~35 preguntes noves de "més alt o més baix"
# (surten de parelles a l'atzar), i amb el temps desequilibraria el pou.
SEED_ON_BOOT=0
# Si es deixen buits, NO es crea cap administrador. La contrasenya de dev
# (admin@quizcat.local / admin1234) és pública al repositori i no serveix aquí.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
