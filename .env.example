# --- API ---
DATABASE_URL="postgresql://quizcat:quizcat@localhost:5444/quizcat?schema=public"
# Obligatori. En producció l'''API no arrenca sense això (cap valor per defecte:
# amb un secret conegut qualsevol es pot signar un token vàlid).
JWT_SECRET="canvia-aixo-en-produccio"
PORT=4400

# --- MinIO (S3-compatible) — storage d'àudios/imatges ---
# Buit o absent = storage desactivat: el joc tira amb els fitxers locals de web/public.
# Dev: els valors de docker-compose.dev.yml (l'S3 escolta al 9010, consola al 9011).
S3_ENDPOINT="http://localhost:9010"
S3_BUCKET="quizcat-media"
S3_ACCESS_KEY="quizcat"
S3_SECRET_KEY="quizcat-dev-2026"

# --- Seed en producció ---
# Sense SEED_ADMIN_PASSWORD i amb NODE_ENV=production, el seed NO crea cap admin.
# En dev crea admin@quizcat.local / admin1234.
# SEED_ADMIN_EMAIL="tu@exemple.cat"
# SEED_ADMIN_PASSWORD=""
